// Lib Quest - MVP data model
// 초기 MVP: 대표 도서관 1곳, 퀘스트 3개, 도서 30~50권 규모를 가정한 최소 스키마

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Library {
  id    String @id @default(cuid())
  code  String @unique // 도서관 정보나루 libCode
  name  String

  books  Book[]
  quests Quest[]

  createdAt DateTime @default(now())
}

model Book {
  id             String   @id @default(cuid())
  libraryId      String
  library        Library  @relation(fields: [libraryId], references: [id])
  isbn13         String
  title          String
  author         String?
  classNo        String? // 분류번호
  className      String? // 분류명
  callNumber     String? // 청구기호
  shelfLocation  String? // 자료실/층 위치
  registeredAt   DateTime? // 등록일 (원본 데이터 기준)
  source         String   // 데이터 출처 (예: "도서관정보나루 API")

  candidates QuestCandidate[]
  editorial  BookEditorial?

  createdAt DateTime @default(now())

  @@unique([libraryId, isbn13])
  @@index([libraryId])
}

model Quest {
  id                String   @id @default(cuid())
  libraryId         String
  library           Library  @relation(fields: [libraryId], references: [id])
  title             String
  description       String
  theme             String?
  estimatedMinutes  Int?
  difficulty        String? // easy | normal | hard
  published         Boolean  @default(false)

  steps    QuestStep[]
  sessions QuestSession[]

  createdAt DateTime @default(now())

  @@index([libraryId])
}

model QuestStep {
  id          String @id @default(cuid())
  questId     String
  quest       Quest  @relation(fields: [questId], references: [id])
  order       Int
  title       String
  description String
  hint        String?

  candidates     QuestCandidate[]
  missionContent MissionContent?

  @@unique([questId, order])
}

model QuestCandidate {
  id          String    @id @default(cuid())
  questStepId String
  questStep   QuestStep @relation(fields: [questStepId], references: [id])
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id])
  isPrimary   Boolean   @default(false)

  @@unique([questStepId, bookId])
}

model QuestSession {
  id          String    @id @default(cuid())
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id])
  currentStep Int       @default(1)
  completedAt DateTime?

  createdAt DateTime @default(now())
}

// 운영자가 /admin/review에서 검수·수정하는 운영 콘텐츠(P1). "검수 완료"와 "이용자 공개"는
// 서로 다른 축이라 BookEditorial/MissionContent 둘 다 reviewStatus와 isPublished를 별도로 갖는다
// — 검수는 끝났지만 아직 공개하지 않은 상태가 가능해야 하기 때문이다. isPublished=true는
// reviewStatus=APPROVED일 때만 서버에서 허용한다(검증은 API 레이어에서 수행, DB 제약은 아님).
enum ReviewStatus {
  DRAFT
  REVIEW_NEEDED
  APPROVED
}

// 책 발견 후 보여주는 teaser/hook/question의 운영 콘텐츠. 기존 data/libraries/<libCode>/
// book-editorial.json은 이 테이블의 초기 baseline(seed/import 원본이자 데모 초기화 기준)으로만
// 쓰이고, 사용자 화면(verify API)은 이 테이블을 source of truth로 조회한다.
model BookEditorial {
  id           String       @id @default(cuid())
  bookId       String       @unique
  book         Book         @relation(fields: [bookId], references: [id])
  hook         String?
  teaser       String?
  question     String?
  reviewStatus ReviewStatus @default(DRAFT)
  isPublished  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Step을 지시문이 아닌 탐험 서사로 감싸는 missionTitle/missionNarrative의 운영 콘텐츠.
// data/libraries/<libCode>/quest-missions.json이 초기 baseline이다. BookEditorial과 동일한
// 검수/공개 정책을 따른다.
model MissionContent {
  id               String       @id @default(cuid())
  questStepId      String       @unique
  questStep        QuestStep    @relation(fields: [questStepId], references: [id])
  missionTitle     String?
  missionNarrative String?
  reviewStatus     ReviewStatus @default(DRAFT)
  isPublished      Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
